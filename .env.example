# .env.example — Plantilla de variables de entorno.
# Copiar a .env (ignorado por git) y completar con valores reales. Nunca subir valores reales.
# En producción, estas variables se cargan en el panel de Vercel.

# --- Supabase ---
# Supabase usa las claves NUEVAS (Settings → API Keys), que reemplazan a las legacy
# "anon" y "service_role". Los nombres de las variables se mantienen por compatibilidad.
#
# URL del proyecto (pública; también la usa el navegador).
SUPABASE_URL=
# Publishable key nueva (empieza con sb_publishable_...). Reemplaza a la anon key legacy.
# Pública: la usa el navegador; lo que puede ver o hacer lo limita RLS.
SUPABASE_ANON_KEY=
# Secret key nueva (empieza con sb_secret_...). Reemplaza a la service_role key legacy.
# SECRETA: solo en /api, nunca en el navegador ni en el repo; saltea RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 (todas SECRETAS; solo en /api) ---
# ID de la cuenta de Cloudflare (arma el endpoint de R2).
R2_ACCOUNT_ID=
# Access Key ID del token de API de R2 (Object Read & Write).
R2_ACCESS_KEY_ID=
# Secret Access Key del mismo token.
R2_SECRET_ACCESS_KEY=
# Nombre del bucket privado.
R2_BUCKET=
